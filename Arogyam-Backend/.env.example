# ==============================================================================
# Arogyam Backend - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials before running.
# ==============================================================================

# Server Configuration
PORT=3000

# PostgreSQL Database (Neon / Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/arogyam_db?sslmode=disable"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# Firebase Admin SDK (Service Account Credentials)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQCfakeexamplekey\n-----END PRIVATE KEY-----\n"

# Vapi AI Outbound Voice Calling Integration
# Obtain from https://dashboard.vapi.ai
VAPI_PRIVATE_KEY="vapi_priv_0123456789abcdef0123456789abcdef"
VAPI_ASSISTANT_ID="asst_0123456789abcdef0123456789abcdef"
VAPI_PHONE_NUMBER_ID="phone_0123456789abcdef0123456789abcdef"
VAPI_WEBHOOK_SECRET="vapi_whsec_0123456789abcdef"